{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Prettier: Format all",
      "type": "npm",
      "script": "format",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Prettier: Check formatting",
      "type": "npm",
      "script": "format:check",
      "problemMatcher": []
    },
    {
      "label": "ESLint: Lint",
      "type": "npm",
      "script": "lint",
      "problemMatcher": ["$eslint-stylish"]
    },
    {
      "label": "ESLint: Fix all",
      "type": "npm",
      "script": "lint:fix",
      "problemMatcher": ["$eslint-stylish"]
    },
    {
      "label": "Open in Live Server",
      "type": "shell",
      "command": "open http://127.0.0.1:5500/index.html",
      "problemMatcher": []
    }
  ]
}
